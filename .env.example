# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# docker compose reads `.env` automatically and substitutes the ${VAR} refs
# in docker-compose.yml.

# --- Video summary tool (/#/summary) ---
# Required. Without it the summary tool returns 503.
# Default provider is DeepSeek (OpenAI-compatible); use any compatible endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_TIMEOUT=60
# Per-chunk subtitle char budget for long-video map-reduce summarization.
SUMMARY_MAX_INPUT_CHARS=9000

# --- Bilibili (optional, improves reliability of download + subtitle fetch) ---
# Either drop a Netscape cookies file at ./cookies/bilibili.cookies.txt, or set
# a raw browser Cookie header here:
# BILIBILI_COOKIE_HEADER=SESSDATA=...; bili_jct=...; DedeUserID=...
